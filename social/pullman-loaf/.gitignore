# Italian Plate No1 Expanded is a licensed retail family (Zetafonts) and this
# repo is public. tools/make_fonts.py inlines it as a base64 WOFF2 subset, so
# the font -- and any build output carrying it -- stays out of version control.
#
# To rebuild: drop the OTFs into tools/fonts/ and run tools/make_fonts.py.
tools/fonts/*.otf
tools/fonts/IP-*.woff2
tools/fonts/inline.css
tools/fonts/inline-bodoni.css

# build outputs of the above
ff-pullman-post.html
ff-pullman-post-blue.html
partanna-pullman-bag.html
